# KDE Plasma (X11 session), dressed up as Windows 11 by hooks/ and desktop/.

# Display server and login screen
xserver-xorg
xserver-xorg-input-libinput
x11-xserver-utils
x11-utils
sddm
kde-config-sddm
qml6-module-qtquick-virtualkeyboard  # on-screen keyboard at sign-in
qt6-virtualkeyboard-plugin
libpam-kwallet5  # unlocks saved passwords at sign-in instead of asking again

# Plasma desktop (taskbar, window manager, tray applets)
plasma-desktop
plasma-workspace
kwin-x11
kscreen
powerdevil
plasma-nm
plasma-pa
bluedevil
kde-config-screenlocker
polkit-kde-agent-1
xdg-desktop-portal-kde
kde-config-gtk-style
breeze
breeze-gtk-theme
kinfocenter
systemsettings
qt6-svg-plugins
qt6-image-formats-plugins
kimageformat6-plugins
kio-extras
ffmpegthumbs
kdegraphics-thumbnailers
icoutils
gtk-update-icon-cache
qt-style-kvantum
plasma-discover
plasma-discover-backend-flatpak
flatpak
print-manager
kmenuedit
plasma-integration
kde-cli-tools
kde-config-flatpak
packagekit-tools
qdbus-qt6
pulseaudio-utils
libnotify-bin  # notify-send, which many scripts and some apps use to show notifications
xdg-utils
xdg-user-dirs
xinput
spice-vdagent
unzip

# Windows-style apps (renamed by hooks/20-apps.sh: File Explorer, Notepad, Paint, Photos...)
dolphin
konsole
kwrite
gwenview
okular
ark
kcalc
kolourpaint
kcharselect
kde-spectacle
haruna
partitionmanager
firefox-esr
kdialog

# Fonts (Selawik is installed by hooks/10-themes.sh)
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-crosextra-carlito
fonts-crosextra-caladea
fonts-dejavu-core
fonts-cascadia-code

# Glass Panes' own apps: Start menu, Settings, Task Manager, Run
python3
python3-pyqt6
python3-pyqt6.qtsvg
python3-psutil
python3-xlib

# Cherry Store and Cherry Move come from vendor/cherry-kit/ (build.sh runs its install script after
# this list). Their GTK 4 windows need the SVG loader (librsvg2-common), or Win11 icons such as the
# USB stick show as broken images.
librsvg2-common
