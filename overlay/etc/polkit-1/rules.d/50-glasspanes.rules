// Like a Windows administrator account: administrators (the sudo group) can change the time,
// PC name and network settings, and mount drives without typing their password every time.
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("sudo"))
        return;
    var id = action.id;
    if (id.indexOf("org.freedesktop.timedate1.") === 0 ||
        id.indexOf("org.freedesktop.hostname1.") === 0 ||
        id.indexOf("org.freedesktop.NetworkManager.") === 0 ||
        id.indexOf("org.freedesktop.udisks2.filesystem-mount") === 0 ||
        id.indexOf("org.freedesktop.login1.") === 0 ||
        id === "org.freedesktop.packagekit.system-update" ||
        id === "org.freedesktop.packagekit.package-install" ||
        id === "org.freedesktop.packagekit.system-sources-refresh")
        return polkit.Result.YES;
});
